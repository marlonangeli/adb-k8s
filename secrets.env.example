#!/bin/bash
# Copie este arquivo para secrets.env e personalize antes da instalação.

# Credenciais
export GRAFANA_ADMIN_USER="admin"
export GRAFANA_ADMIN_PASSWORD="CHANGE_ME_GRAFANA"

export RANCHER_ADMIN_PASSWORD="CHANGE_ME_RANCHER"

# Planeje definir assim que o Argo CD for provisionado
export ARGOCD_ADMIN_USERNAME="admin"
export ARGOCD_ADMIN_PASSWORD="CHANGE_ME_ARGOCD"
# URLs dos repositórios Git monitorados pelo Argo CD (ajuste para sua organização)
export ADB_API_REPO_URL="https://github.com/seu-usuario/adb-api-3.git"
export ADB_API_REVISION="main"
export INTERPOLATION_REPO_URL="https://github.com/seu-usuario/adb-interpolation-api.git"
export INTERPOLATION_REPO_REVISION="main"

# Certificados públicos via Let's Encrypt (opcional – mantenha comentado se for usar apenas HTTP interno)
# export CERT_MANAGER_ACME_EMAIL="your_email@example.com"
# export CERT_MANAGER_ACME_ISSUER_NAME="letsencrypt-prod"
# export CERT_MANAGER_ACME_SERVER="https://acme-v02.api.letsencrypt.org/directory"
# export CERT_MANAGER_ACME_INGRESS_CLASS="nginx"
# export TLS_CLUSTER_ISSUER="letsencrypt-prod"

# Outras senhas ou tokens podem ser adicionados aqui conforme necessário.
